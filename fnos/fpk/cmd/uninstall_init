#!/usr/bin/env bash
# 卸载前：应用文件还在，此时清理容器与 compose 项目（含网络/卷声明）。
# 用户数据（@appdata/wb2api-panel）一律不删——由用户自行决定。
set -u

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
APPDEST_FALLBACK="$(dirname "$(dirname "$SELF_DIR")")"
if [ -n "${TRIM_APPDEST:-}" ]; then
  APPDEST="$TRIM_APPDEST"
elif [ -f "$APPDEST_FALLBACK/app/docker/docker-compose.yaml" ]; then
  APPDEST="$APPDEST_FALLBACK/app"
else
  APPDEST="$APPDEST_FALLBACK/target"
fi
# 布局映射：项目 app/ → 安装后 target/，compose 在 $APPDEST/docker/（无 app/ 前缀）
COMPOSE_FILE="$APPDEST/docker/docker-compose.yaml"

if [ -f "$COMPOSE_FILE" ] && command -v docker >/dev/null 2>&1; then
  docker compose -p wb2api-panel -f "$COMPOSE_FILE" down >/dev/null 2>&1 || true
fi
exit 0
